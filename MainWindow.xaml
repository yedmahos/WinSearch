<Window
    x:Class="WinSearch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Native Windows 11 Acrylic -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <!-- No outside margin or padding -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent">

        <!-- Main Figma panel -->
        <Border
            x:Name="SearchPanel"
            Width="680"
            Padding="13"
            CornerRadius="20"
            BorderThickness="0"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

            <StackPanel Spacing="8">

                <!-- Search field: 654 x 48 -->
                <Border
                    Height="48"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                    <Grid Height="46">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search input -->
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="0"
                            Height="46"
                            MinHeight="0"
                            FontSize="20"
                            FontFamily="Segoe UI Variable"
                            TextAlignment="Left"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="10,6,0,0"
                            BorderThickness="0"
                            Background="Transparent"
                            PlaceholderText="Spotlight Search"
                            TextChanged="SearchBox_TextChanged"
                            KeyDown="SearchBox_KeyDown">

                            <TextBox.Resources>
                                <SolidColorBrush
                                    x:Key="TextControlBorderBrush"
                                    Color="Transparent"/>

                                <SolidColorBrush
                                    x:Key="TextControlBorderBrushPointerOver"
                                    Color="Transparent"/>

                                <SolidColorBrush
                                    x:Key="TextControlBorderBrushFocused"
                                    Color="Transparent"/>

                                <Thickness
                                    x:Key="TextControlBorderThemeThickness">
                                    0
                                </Thickness>

                                <Thickness
                                    x:Key="TextControlBorderThemeThicknessFocused">
                                    0
                                </Thickness>
                            </TextBox.Resources>

                        </TextBox>

                        <!-- Right-side search icon -->
                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xE721;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="20"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>

                        <!-- Figma focus indicator -->
                        <Border
                            Grid.ColumnSpan="2"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            IsHitTestVisible="False"/>

                    </Grid>
                </Border>

                <!-- Existing dynamic results -->
                <StackPanel
                    x:Name="ResultsHost"
                    Visibility="Collapsed"
                    Spacing="0"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>
