<Window
    x:Class="WinSearch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A transparent window hosts a rounded, independently tinted acrylic surface. -->

    <!-- No outside margin or padding -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent">

        <Grid x:Name="GlassSurface" Width="680"
              HorizontalAlignment="Center" VerticalAlignment="Top">
            <SystemBackdropElement x:Name="GlassBackdrop"
                                   CornerRadius="20" IsHitTestVisible="False"/>
            <Border x:Name="GlassEdge" CornerRadius="20"
                    BorderThickness="1" IsHitTestVisible="False"/>
        <!-- Search content retains its existing dimensions and padding. -->
        <Border
        x:Name="SearchPanel"
        Width="680"
        Padding="13"
        CornerRadius="20"
        BorderThickness="0"
        Background="Transparent"
        HorizontalAlignment="Center"
        VerticalAlignment="Top">

            <StackPanel Spacing="8">

                <!-- Search field: 654 x 48 -->
                <Border
                    x:Name="SearchField"
                    Height="48"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                    <Grid Height="46">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search input -->
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="0"
                            Height="46"
                            MinHeight="0"
                            FontSize="20"
                            FontFamily="Segoe UI Variable"
                            TextAlignment="Left"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="11,0,0,0"
                            BorderThickness="0"
                            Background="Transparent"
                            PlaceholderText="Win Search"
                            TextChanged="SearchBox_TextChanged"
                            KeyDown="SearchBox_KeyDown">

                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid Background="Transparent">
                                        <ScrollViewer x:Name="ContentElement"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                                            IsTabStop="False" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="QueryPlaceholder" Text="{TemplateBinding PlaceholderText}"
                                            Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}" Opacity="0.6"
                                            IsHitTestVisible="False"/>
                                    </Grid>
                                </ControlTemplate>
                            </TextBox.Template>
                            <TextBox.Resources>
                                <SolidColorBrush
                                    x:Key="TextControlBorderBrush"
                                    Color="Transparent"/>

                                <SolidColorBrush
                                    x:Key="TextControlBorderBrushPointerOver"
                                    Color="Transparent"/>

                                <SolidColorBrush
                                    x:Key="TextControlBorderBrushFocused"
                                    Color="Transparent"/>

                                <Thickness
                                    x:Key="TextControlBorderThemeThickness">
                                    0
                                </Thickness>

                                <Thickness
                                    x:Key="TextControlBorderThemeThicknessFocused">
                                    0
                                </Thickness>
                            </TextBox.Resources>

                        </TextBox>

                        <Button x:Name="ClearQueryButton" Grid.Column="1"
                                Width="28" Height="28" MinWidth="0" MinHeight="0"
                                Padding="8" BorderThickness="0" Background="Transparent"
                                Visibility="Collapsed" Click="ClearQuery_Click"
                                AutomationProperties.Name="Clear search" ToolTipService.ToolTip="Clear search">
                            <Image x:Name="ClearGlyph" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Image x:Name="SearchGlyph" Grid.Column="2"
                               Width="20" Height="20" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                        <!-- Figma focus indicator -->
                        <Border
                            Grid.ColumnSpan="3"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="#0067C0"
                            IsHitTestVisible="False"/>

                    </Grid>
                </Border>

                <!-- Existing dynamic results -->
                <StackPanel
                    x:Name="ResultsHost"
                    Visibility="Collapsed"
                    Spacing="0"/>

            </StackPanel>

        </Border>
        </Grid>

    </Grid>
</Window>
